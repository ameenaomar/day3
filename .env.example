# Supabase Auth, project `simply-styled` (ref djkpilwfcokgjjtbwker, eu-central-1).
# Sign-up and sign-in run through it, and these two values are public by
# design — the publishable key ships in the browser bundle. Row level security
# is what protects the data: the `anon` role is granted nothing at all, and a
# signed-in customer can reach only their own row.
#
# Dashboard -> Project settings -> API. Either the `sb_publishable_...` key or
# the legacy JWT `anon` key works; prefer the publishable one.
#
# Read server-side, so a change takes effect on redeploy. The NEXT_PUBLIC_
# spellings are accepted too, for a deployment already configured that way.
SUPABASE_URL="https://djkpilwfcokgjjtbwker.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# Postgres — the same Supabase project, reached directly. Copy both strings
# from Dashboard -> Connect; they carry the database password, which is why
# they are not written down here.
#
#   DATABASE_URL         Transaction pooler, port 6543 — what the app uses. A
#                        serverless function per request exhausts direct
#                        connections, so this one is not optional.
#   DIRECT_DATABASE_URL  Direct connection, port 5432 — migrations only.
#
# Nothing on the sign-in path needs these: that is Supabase Auth, over HTTPS.
# They are for the style profile, the orders and the stylist's tool.
DATABASE_URL="postgresql://postgres.djkpilwfcokgjjtbwker:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_DATABASE_URL="postgresql://postgres.djkpilwfcokgjjtbwker:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# The site's own origin. No trailing slash. Confirmation links point back here,
# so it has to match one of the redirect URLs allowed in Supabase Auth.
APP_URL="http://localhost:3000"

# Signing key for anything this app signs itself. Supabase Auth signs the
# session, so nothing needs this yet. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Transactional email for order confirmations. Supabase sends the account
# emails — confirmation and password reset — itself.
RESEND_API_KEY=""
EMAIL_FROM="Simply Styled <hello@example.com>"

# Payment gateway. "mock" runs the whole flow locally with no credentials.
PAYMENT_PROVIDER="mock"
