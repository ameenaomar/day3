# Supabase. Sign-up and sign-in run through Supabase Auth; these two values are
# public — the publishable key ships in the browser bundle, and in
# public/whatcaniwear.html. Row level security is what protects the data: the
# `anon` role is granted nothing, and a signed-in customer can reach only their
# own row.
#
# Project settings -> API. Either the `sb_publishable_...` key or the legacy
# JWT `anon` key works; prefer the publishable one.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Postgres, which is the same Supabase project. Copy both from the dashboard
# (Connect) — they carry the database password, so they are not in the repo.
#
# DATABASE_URL must be the **transaction pooler**, port 6543: a serverless
# function per request would exhaust direct connections. DIRECT_DATABASE_URL is
# the direct connection on 5432, which migrations need.
#
# Nothing on the sign-in path uses these — that is Supabase Auth. They are for
# the style profile, orders and the stylist's tool.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"
DIRECT_DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# The site's own origin. No trailing slash. Confirmation links point back here,
# so it has to match one of the redirect URLs allowed in Supabase Auth.
APP_URL="http://localhost:3000"

# Signing key for anything this app signs itself. Supabase Auth signs the
# session, so nothing needs this yet. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Transactional email for order confirmations. Supabase sends the auth emails
# (confirmation, password reset) itself.
RESEND_API_KEY=""
EMAIL_FROM="Simply Styled <hello@example.com>"

# Payment gateway. "mock" runs the whole flow locally with no credentials.
PAYMENT_PROVIDER="mock"
